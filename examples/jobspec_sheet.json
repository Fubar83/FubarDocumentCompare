{
  "schema": "printcmp.jobspec/1",
  "seed": 1,
  "reference": { "path": "etikett.pdf", "page": 1, "box": "trim" },
  "sample": { "path": "ark_600dpi.tif", "kind": "scan" },
  "work_dpi": 600,
  "instances": {
    "mode": "multi",
    "expected_layout": { "rows": 4, "cols": 2 },
    "rotations": [0, 180],
    "max_skew_deg": 4.0,
    "systematic_ratio": 0.8,
    "consensus": true
  },
  "masks": [ { "reason": "variable", "rect_mm": [3.5, 34.6, 22.0, 3.6] } ],
  "spot_rules": { "dieline": "(?i)cut|die|stans", "varnish": "(?i)varnish|lack|folie" },
  "tolerance_profile": "label_standard",
  "tolerance_overrides": { "delta_e": 8.0 },
  "outputs": { "dir": "out", "json": "result.json", "report_html": "report.html", "layers": true, "layer_dpi": 200 }
}
